rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // DigiVault public store & admin collection rules
    match /products/{productId} {
      allow read: if true;
      allow write: if true; // Allows client-side admin management in demo/production
    }
    match /orders/{orderId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if true;
    }
    match /promos/{promoId} {
      allow read: if true;
      allow write: if true;
    }
    match /settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
